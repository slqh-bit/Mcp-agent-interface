// agent-interface-kit — data model (plan §5.1 public catalogue, §5.2 tenant workspace)
// Conventions (§5.3): money as BigInt millimes (1 TND = 1000), timestamps UTC.
// The FTS searchVector column is Unsupported here; it is created by the raw SQL
// migration in prisma/migrations/ (generated tsvector, french + unaccent).

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
  // queryCompiler compiles queries to SQL in wasm (no glibc query-engine
  // binary), driverAdapters executes via @prisma/adapter-pg — together they
  // let Prisma Client run on Android/Termux's bionic libc (see README).
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BuyerType {
  MINISTRY
  MUNICIPALITY
  PUBLIC_COMPANY
  ESTABLISHMENT
  OTHER
}

enum ProcedureType {
  OPEN
  RESTRICTED
  CONSULTATION
  NEGOTIATED
  OTHER
}

enum TenderCategory {
  WORKS
  SUPPLIES
  SERVICES
  STUDIES
}

enum TenderStatus {
  OPEN
  CLOSED
  CANCELLED
  AWARDED
  UNKNOWN
}

enum TenderEventType {
  CREATED
  DEADLINE_CHANGED
  AMENDED
  CANCELLED
  AWARDED
  STATUS_CHANGED
}

enum PipelineStage {
  WATCHING
  QUALIFYING
  PREPARING
  SUBMITTED
  WON
  LOST
  DROPPED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ChecklistCategory {
  admin
  technical
  financial
}

enum AlertKind {
  NEW_MATCH
  DEADLINE_SOON
  TENDER_AMENDED
  TENDER_CANCELLED
}

enum AuditOutcome {
  SUCCESS
  ERROR
  DENIED
}

enum IngestionRunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

// ---------------------------------------------------------------------------
// §5.1 Public catalogue (global, read-only for agents)
// ---------------------------------------------------------------------------

model Buyer {
  id      String    @id @default(uuid())
  name    String // FR name
  nameAr  String?
  type    BuyerType
  region  String? // gouvernorat
  tenders Tender[]

  @@unique([name])
}

model Tender {
  id              String          @id @default(uuid())
  reference       String          @unique // TUNEPS ref e.g. "S2026…" or source-specific
  source          String // "tuneps" | "manual" | "ministry:mtc" …
  sourceUrl       String?
  buyerId         String
  buyer           Buyer           @relation(fields: [buyerId], references: [id])
  title           String
  titleAr         String?
  summary         String?
  procedureType   ProcedureType
  category        TenderCategory
  cpvOrSector     String[] // normalised sector tags ("network","cctv","it")
  region          String?
  publishedAt     DateTime?
  deadlineAt      DateTime // stored UTC, displayed Africa/Tunis
  openingAt       DateTime? // ouverture des plis
  bidBondMillimes BigInt? // caution provisoire, TND × 1000
  status          TenderStatus    @default(OPEN)
  lots            Lot[]
  documents       TenderDocument[]
  events          TenderEvent[]
  searchVector    Unsupported("tsvector")? // generated column (raw SQL migration)
  firstSeenAt     DateTime        @default(now())
  lastSeenAt      DateTime        @default(now())
  contentHash     String // detects changes between crawls

  @@index([deadlineAt])
  @@index([status, deadlineAt])
}

model Lot {
  id              String @id @default(uuid())
  tenderId        String
  tender          Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  bidBondMillimes BigInt?

  @@unique([tenderId, number])
}

model TenderDocument {
  id       String @id @default(uuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  kind     String // "avis", "cahier_des_charges", "rectificatif"
  title    String
  url      String? // link only — no mirroring in v1
}

model TenderEvent {
  id       String          @id @default(uuid())
  tenderId String
  tender   Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  type     TenderEventType
  before   Json?
  after    Json?
  at       DateTime        @default(now())

  @@index([tenderId, at])
}

model IngestionRun {
  id           String             @id @default(uuid())
  source       String // adapter id: "manual" | "tuneps" | "ministry:mtc" …
  status       IngestionRunStatus @default(SUCCESS)
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  fetched      Int                @default(0)
  upserted     Int                @default(0)
  events       Int                @default(0)
  errors       Json               @default("[]")

  @@index([source, startedAt])
}

// ---------------------------------------------------------------------------
// §5.2 Tenant workspace (tenant-scoped, agents read and write)
// ---------------------------------------------------------------------------

model Tenant {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  locale         String          @default("fr") // "fr" | "ar" | "en"
  timezone       String          @default("Africa/Tunis")
  createdAt      DateTime        @default(now())
  apiTokens      ApiToken[]
  trackedTenders TrackedTender[]
  savedSearches  SavedSearch[]
  alerts         Alert[]
  auditLogs      AuditLog[]
}

model ApiToken {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String    @unique
  hash       String    @unique
  scopes     String[]
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model TrackedTender {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenderId         String
  stage            PipelineStage   @default(WATCHING)
  owner            String? // team member name/email
  priority         Priority        @default(MEDIUM)
  internalDeadline DateTime? // e.g. 3 days before official deadline
  notes            TrackingNote[]
  checklist        ChecklistItem[]
  createdBy        String // "agent:<prefix>" | "user:<id>"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  archivedAt       DateTime? // soft "untrack"

  @@unique([tenantId, tenderId])
  @@index([tenantId, stage])
  @@index([tenderId])
}

model TrackingNote {
  id        String        @id @default(uuid())
  trackedId String
  tracked   TrackedTender @relation(fields: [trackedId], references: [id], onDelete: Cascade)
  body      String
  author    String
  createdAt DateTime      @default(now())

  @@index([trackedId])
}

model ChecklistItem {
  id        String            @id @default(uuid())
  trackedId String
  tracked   TrackedTender     @relation(fields: [trackedId], references: [id], onDelete: Cascade)
  label     String
  labelAr   String?
  category  ChecklistCategory
  required  Boolean
  done      Boolean           @default(false)
  dueAt     DateTime?
  sortOrder Int

  @@index([trackedId])
}

model SavedSearch {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String // "CCTV & vidéosurveillance"
  query      Json // same shape as search_tenders input
  notify     Boolean   @default(true)
  channel    String    @default("email") // email | telegram (Phase 2+)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([tenantId])
}

model Alert {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      AlertKind
  tenderId  String
  searchId  String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, kind, tenderId, searchId]) // no duplicate alerts
  @@index([tenantId, createdAt])
}

model AuditLog {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tool        String
  input       Json? // redacted tool input
  outcome     AuditOutcome
  resourceIds String[]
  durationMs  Int
  clientName  String?
  ip          String?
  createdAt   DateTime     @default(now())

  @@index([tenantId, createdAt])
}
