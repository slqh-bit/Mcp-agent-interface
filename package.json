{
  "name": "agent-interface-kit",
  "version": "0.1.0",
  "description": "MCP server exposing TUNEPS Tunisian public-tender intelligence to AI agents",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "express": "5.2.1",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@prisma/client": "6.19.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  }
}
